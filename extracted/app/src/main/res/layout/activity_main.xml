<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context=".MainActivity">

    <!-- Top App Bar & Connection Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/surface_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Top Row: App Title, Status Indicator, Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_bluetooth_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_bluetooth" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/view_status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_status_badge"
                            android:backgroundTint="@color/status_disconnected" />

                        <TextView
                            android:id="@+id/tv_connection_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/status_not_connected"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Keyboard Panel Toggle Button -->
                <ImageButton
                    android:id="@+id/btn_toggle_keyboard"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_keyboard"
                    android:src="@drawable/ic_keyboard"
                    app:tint="@color/primary_light" />

                <!-- Settings Button -->
                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Bluetooth Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_search_pair"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_scan_devices"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconTint="@color/white" />

                <Button
                    android:id="@+id/btn_make_discoverable"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_make_discoverable"
                    android:textColor="@color/primary_light"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_visibility"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconTint="@color/primary_light" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Expandable Keyboard & Media Input Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_keyboard_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/surface_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Text Entry Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_keyboard_input"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_touchpad_button"
                    android:hint="@string/keyboard_input_hint"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btn_send_text"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_key_chip_accent"
                    android:contentDescription="@string/send_text"
                    android:src="@drawable/ic_send"
                    app:tint="@color/primary_light" />

                <ImageButton
                    android:id="@+id/btn_key_backspace"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_key_chip"
                    android:contentDescription="@string/key_backspace"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/text_primary" />

                <Button
                    android:id="@+id/btn_key_enter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_key_chip_accent"
                    android:minWidth="50dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="↵"
                    android:textColor="@color/primary_light"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Horizontal Scrollable Shortcuts & Hotkeys -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Special Keys -->
                    <Button
                        android:id="@+id/btn_key_esc"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="44dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Esc"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="44dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Tab ⇥"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_space"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="54dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Space"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_win"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip_accent"
                        android:minWidth="56dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Win ⊞"
                        android:textColor="@color/primary_light"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_ctrl_c"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="50dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Ctrl+C"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_ctrl_v"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="50dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Ctrl+V"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_ctrl_z"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="50dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Ctrl+Z"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_ctrl_a"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="50dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Ctrl+A"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_alt_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="56dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Alt+Tab"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@null" />

                    <!-- Arrow Keys -->
                    <Button
                        android:id="@+id/btn_key_arrow_up"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="36dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="↑"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_arrow_down"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="36dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="↓"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_arrow_left"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="36dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="←"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_key_arrow_right"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:minWidth="36dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="→"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <!-- Media Buttons -->
                    <ImageButton
                        android:id="@+id/btn_media_play_pause"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:contentDescription="@string/media_controls"
                        android:src="@drawable/ic_play_pause"
                        app:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/btn_media_vol_down"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:contentDescription="@string/media_controls"
                        android:src="@drawable/ic_volume_down"
                        app:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/btn_media_vol_up"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_key_chip"
                        android:contentDescription="@string/media_controls"
                        android:src="@drawable/ic_volume_up"
                        app:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/btn_media_mute"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_key_chip"
                        android:contentDescription="@string/media_controls"
                        android:src="@drawable/ic_volume_mute"
                        app:tint="@color/text_primary" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Touchpad Interactive Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Touchpad Surface Frame -->
        <FrameLayout
            android:id="@+id/layout_touchpad_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_touchpad"
            android:clickable="true"
            android:focusable="true">

            <!-- Center Subtle Guide Text & Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.4"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/touchpad_hint"
                    android:src="@drawable/ic_mouse"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/touchpad_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Touchpad Surface View for Touch Events -->
            <View
                android:id="@+id/view_touchpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

        <!-- Vertical Scroll Strip -->
        <LinearLayout
            android:id="@+id/view_scroll_strip"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scroll_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/scroll_area"
                android:src="@drawable/ic_chevron_up" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:rotation="90"
                android:text="@string/scroll_area"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/scroll_area"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

    </LinearLayout>

    <!-- Physical Hardware Mouse Buttons (Left, Middle, Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_left_click"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="2"
            android:background="@drawable/bg_touchpad_button"
            android:text="@string/left_click"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_middle_click"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_touchpad_button"
            android:text="@string/middle_click"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_right_click"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_weight="2"
            android:background="@drawable/bg_touchpad_button"
            android:text="@string/right_click"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Gesture Reference Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap: Left Click • Double Tap: 2x • Hold: Right Click • Keyboard Toggle ⌨"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
